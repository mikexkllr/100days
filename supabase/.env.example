# Secrets of the backend. Copy to supabase/.env (git-ignored) for
# `supabase config push`, and set the function secrets with
# `supabase secrets set --env-file supabase/.env`.
# Never commit real values: the repository is public.

# --- Auth (config.toml) ---------------------------------------------------
# Google: OAuth client ids from Google Cloud, comma-separated (web,ios).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# The web client's secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Apple: the app's bundle id (native sign-in needs no secret).
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.hundreddays.hundredDays
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- delete-account: revoke Sign in with Apple (optional) -----------------
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_ID=com.hundreddays.hundredDays
