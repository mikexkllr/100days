<?xml version="1.0" encoding="utf-8"?>
<!-- Open after eight in the evening: red, urgent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="315"
        android:centerColor="#FF120E2A"
        android:endColor="#FF07051A"
        android:startColor="#FF4A1024"
        android:type="linear" />
    <stroke
        android:width="1.5dp"
        android:color="#CCF43F5E" />
</shape>
