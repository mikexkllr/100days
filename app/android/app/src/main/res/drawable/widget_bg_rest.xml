<?xml version="1.0" encoding="utf-8"?>
<!-- Rest day or a freeze: cool blue. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="26dp" />
    <gradient
        android:angle="315"
        android:centerColor="#FF10121A"
        android:endColor="#FF05060B"
        android:startColor="#FF102A4A"
        android:type="linear" />
    <stroke
        android:width="1.5dp"
        android:color="#998ADCFF" />
</shape>
