<?xml version="1.0" encoding="utf-8"?>
<!-- Rest day or a freeze: cool blue. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="315"
        android:centerColor="#FF150F1F"
        android:endColor="#FF0C0912"
        android:startColor="#FF10283D"
        android:type="linear" />
    <stroke
        android:width="1.5dp"
        android:color="#995CC8FF" />
</shape>
